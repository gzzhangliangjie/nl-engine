/* M-UI0 demo 样式：demo.rml（C++ 文档，左上）与 scriptdoc.rml（C# 脚本文档，右上）共用。
 * 字体名 = FreeType 从 NotoSans-Regular.ttf name table 读到的 family（"Noto Sans"）。 */
body {
    font-family: Noto Sans;
}

.panel {
    position: absolute;
    width: 340dp;
    padding: 16dp;
    background-color: #1a1f2bcc;
    border-radius: 8dp;
    border: 1dp #3d4557cc;   /* RmlUi 简写不支持 border-style 关键字（恒实线） */
}

.demo     { left: 24dp; top: 24dp; }
.scriptdoc { left: 24dp; top: 170dp; background-color: #16281fb8; }

#title {
    font-size: 18dp;
    color: #e8eaf0;
    margin-bottom: 8dp;
}

#status {
    font-size: 13dp;
    color: #9aa3b5;
    margin-bottom: 8dp;
}

#tick {
    font-size: 13dp;
    color: #7fae8f;
    margin-bottom: 12dp;
}

.btn {
    display: inline-block;
    padding: 6dp 14dp;
    background-color: #2f6fde;
    border-radius: 4dp;
    color: #ffffff;
    font-size: 13dp;
    cursor: pointer;
}

.btn:hover  { background-color: #4a83e8; }
.btn:active { background-color: #2657b4; }

/* M-SP1-d：<sprite> 自定义 element（atlas 纹理共享自 Sprite2DPass）。
 * overflow: hidden 启用 RmlUi scissor 通道（SpriteElement 顶点被裁进卡内）。 */
#sprites-title {
    font-size: 13dp;
    color: #e8eaf0;
    margin-top: 10dp;
    margin-bottom: 6dp;
}

.sprite-row {
    display: block;
    overflow: hidden;
    width: 200dp;
    height: 44dp;
    background-color: #0d1018cc;
    border-radius: 4dp;
    padding: 4dp;
}

.sprite-cell {
    display: inline-block;
    width: 44dp;
    height: 44dp;
    margin-right: 4dp;
}

#sprites-note {
    font-size: 11dp;
    color: #7a8398;
    margin-top: 6dp;
}
