# =====================================================
# Build output（根锚定）
# 教训（2026-11-10，commit 94bbb66）：`build/` 无锚定曾把
# thirdparty/jolt/Build/（上游 CMake 工程）静默挡在 git 外，
# merge 到新 checkout 才炸。目录名通用的规则一律根锚定。
# =====================================================
/build/
/build-vulkan/
/out/
/cmake-build-*/
/.cache/

# 编译/链接中间产物（构建树整目录已忽略，此处兜底防输出逃逸到源码树；
# 注意：不加 *.lib / *.dll —— thirdparty/dotnet-hosting/ 的预编译件是故意入库的）
*.obj
*.o
*.pdb
*.ilk
*.exp
*.idb
*.iobj
*.ipdb

# =====================================================
# CMake generated（精确文件名；禁 *.cmake 通配——
# thirdparty 里 10 份 vendored .cmake 工程文件是故意入库的）
# =====================================================
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/CMakeUserPresets.json
/compile_commands.json

# =====================================================
# IDE
# =====================================================
.vs/
.idea/
.vscode/
*.user
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
ipch/

# =====================================================
# Vendored 工具链（重下成本低，不入库；源码在 thirdparty/slang-reference/）
# =====================================================
thirdparty/slang/dist/
thirdparty/slang/_dl/
thirdparty/slang/_test/

# =====================================================
# Python (tools/showcase)
# =====================================================
__pycache__/
*.pyc

# =====================================================
# dotnet (script/ — nl-script 托管侧)
# =====================================================
script/**/bin/
script/**/obj/

# =====================================================
# 项目生成物与运行期文件
# =====================================================
# .nmesh 转换器生成物：根层不入库；assets/meshlets/ 下的精选资产故意入库
assets/*.nmesh
# ImGui / imgui-node-editor 运行期布局
imgui.ini
NodeEditor.json
# wt_pool 占坑闸锁与收口报告（跨 worktree 共享，见 tools/wt_pool.py）
.wt_pool_busy.json
/.wt_pool_close/

# =====================================================
# OS
# =====================================================
Thumbs.db
Desktop.ini
# Windows 保留名误产生的 0 字节幻影文件（git 无法 add，也不该入库）
/nul

# =====================================================
# 隐私清理（2026-11-14 公开仓 B 方案）：内部工作笔记与 ctest 运行期目录移出跟踪；
# 文件本体保留在本机（.workbuddy/ 为跨 wt junction 共享目录，daily log 照常追加）
/.workbuddy/
/Testing/

# 同款幻影（example/s9-reference/，582B 误重定向产物；回收站与 Win32 删除
# API 均拒收 0x800704B0/拒绝访问，钉 ignore 解除 git add 阻塞，待手删）
example/s9-reference/nul

# .workbuddy 运行时日志（2026-11-14 T0 整轨 merge 清理）：随 feat/worldgen
# 误入库的三份诊断日志，主树侧移出跟踪；文件本体保留在共享 .workbuddy 里。
.workbuddy/bg-last.log
.workbuddy/gate-blocks.log
.workbuddy/viewer-spawn-watch.log

# 注意：*.log / *.tsv 绝不 ignore——example/ 下 113 份 log 与 40 份 tsv
# 是逐字节验收的证据与基线，故意入库（行尾口径见 .gitattributes）。
example/*/verify-*

# city-tools 楼体 OBJ 交付物（M-W0.2）：example/*/blocks/*.obj 是工具真实
# 产物（消费通道：OBJ -> .nmesh/.glb 转换，asset-ingest 轨道），不是编译
# 中间产物——上面的 *.obj 兜底规则会静默挡掉它们，此处根锚定反白。
!example/*/blocks/*.obj
assets/osm/
bg-*.log
